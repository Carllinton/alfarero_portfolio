---
import type { Profile, Section } from "../../portfolio.config";
const {
  p,
  type,
  uid = "desk",
} = Astro.props as { p: Profile; type: Section; uid?: string };
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const asset = (url: string) =>
  /^(https?:|mailto:|#)/.test(url) ? url : base + "/" + url.replace(/^\//, "");
---

{type === "about" && (
  <>
    <p class="lede">{p.summary}</p>
    <p>{p.story}</p>
  </>
)}
{type === "projects" &&
  p.projects.slice(0, uid === "quick" ? 3 : undefined).map((c, i) => (
    <details class="case">
      <summary>
        <span class="folio">FILE {String(i + 1).padStart(2, "0")}</span>
        <span>
          <strong>{c.title}</strong>
          <small>{c.summary}</small>
        </span>
        <b aria-hidden="true">+</b>
      </summary>
      <div class="casebody">
        <dl>
          {[
            ["Problem", c.problem],
            ["My role", c.role],
            ["Process", c.process],
            ["Result", c.result],
          ].map(([a, b]) => (
            <>
              <dt>{a}</dt>
              <dd>{b}</dd>
            </>
          ))}
        </dl>
        {c.metrics.map((m) => (
          <em class="metric">{m}</em>
        ))}
        {c.media.map((m) =>
          m.kind === "image" ? (
            <img class="media" loading="lazy" src={asset(m.url)} alt={m.alt} />
          ) : (
            <iframe
              class="media"
              loading="lazy"
              src={m.url}
              title={m.alt}
              allowfullscreen
            ></iframe>
          ),
        )}
        {c.links.map((l) => (
          <p>
            <a href={asset(l.url)}>{l.label} ↗</a>
          </p>
        ))}
      </div>
    </details>
  ))}
{type === "experience" &&
  p.experience.map((e) => (
    <article class="record">
      <small>{e.date}</small>
      <h3>{e.title}</h3>
      <p>{e.detail}</p>
    </article>
  ))}
{type === "credentials" &&
  p.credentials.map((e) => (
    <article class="record">
      <small>{e.status}</small>
      <h3>{e.title}</h3>
      <p>{e.issuer}</p>
    </article>
  ))}
{type === "skills" &&
  p.skills.map((s) => (
    <article class="skillset">
      <h3>{s.group}</h3>
      <p>{s.items.join("  ·  ")}</p>
    </article>
  ))}
{type === "personal" && <p class="lede">{p.hobbies}</p>}
{type === "contact" && (
  <>
    {p.contact.email && (
      <p>
        <a href={"mailto:" + p.contact.email}>{p.contact.email}</a>
      </p>
    )}
    {p.contact.links.map((l) => (
      <p>
        <a href={l.url}>{l.label} ↗</a>
      </p>
    ))}
    {p.contact.endpoint || p.contact.email ? (
      <form
        method="post"
        data-contact
        data-address={p.contact.email}
        action={p.contact.endpoint || "mailto:" + p.contact.email}
        enctype={
          p.contact.endpoint
            ? "application/x-www-form-urlencoded"
            : "text/plain"
        }
      >
        <label>
          Your email
          <input
            required
            type="email"
            name="email"
            autocomplete="email"
            maxlength="254"
          />
        </label>
        <label>
          Message
          <textarea
            required
            name="message"
            rows="4"
            maxlength="5000"
          ></textarea>
        </label>
        <button class="action">
          {p.contact.endpoint ? "Send message" : "Open email draft"} ↗
        </button>
        <p role="status" class="form-status"></p>
        {p.contact.email && (
          <a class="fallback" href={"mailto:" + p.contact.email}>
            Use your email app instead
          </a>
        )}
      </form>
    ) : (
      <p>This sample profile has no contact inbox.</p>
    )}
  </>
)}
