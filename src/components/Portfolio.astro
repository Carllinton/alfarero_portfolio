---
import type { Profile, Project } from "../../portfolio.config";
import "../styles/keynote.css";

const { p, slug = "" } = Astro.props as { p: Profile; slug?: string };
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const asset = (url: string) => /^(https?:|mailto:|#)/.test(url) ? url : base + "/" + url.replace(/^\//, "");
const resume = base + "/" + (slug ? slug + "/" : "") + "resume.pdf";
const canonical = new URL(Astro.url.pathname, Astro.site);
const preview = new URL(base + "/" + (slug ? slug + "/" : "") + "og.png", Astro.site);
const isContactable = Boolean(p.contact.email || p.contact.endpoint);
const safeAccent = /^#[0-9a-fA-F]{6}$/.test(p.accent) ? p.accent : "#9BE9BB";
const index = (n: number) => String(n + 1).padStart(2, "0");
---
<!doctype html>
<html lang="en" data-theme="dark" style={`--accent:${safeAccent}`}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#101112" />
    <meta name="color-scheme" content="dark light" />
    <meta name="description" content={p.summary} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={p.name + " — Portfolio"} />
    <meta property="og:description" content={p.positioning} />
    <meta property="og:url" content={canonical.toString()} />
    <meta property="og:image" content={preview.toString()} />
    <link rel="canonical" href={canonical.toString()} />
    <link rel="icon" href={base + "/art/favicon.svg"} type="image/svg+xml" />
    <title>{p.name} — Made with purpose.</title>
  </head>
  <body>
    <a class="a11y-skip" href="#story-start">Skip introduction</a>
    <header class="site-header">
      <a class="identity" href="#top" aria-label={"Back to the beginning — " + p.name}>
        <span class="identity-mark" aria-hidden="true"><span></span><span></span><span></span></span>
        <span>{p.firstName}<span class="identity-period">.</span></span>
      </a>
      <div class="header-end">
        <span class="header-status">{p.sample ? "Illustrative portfolio" : "Personal portfolio"}</span>
        <button class="theme-button" type="button" aria-label="Switch to light theme" aria-pressed="false"><span aria-hidden="true" class="theme-glyph">◐</span><span class="theme-word">Light</span></button>
        <a class="summary-link" href="#summary">Skip to summary <span aria-hidden="true">↗</span></a>
      </div>
    </header>
    <main id="top">
      <div class="story" id="story-start">
        <section class="scene scene-intro" data-visual={p.heroVisual} aria-labelledby="intro-title" data-scene>
          <div class="intro-inner">
            <span class="eyebrow reveal">AN INTRODUCTION, NOT A RESUME</span>
            <h1 id="intro-title" class="intro-title"><span class="hello reveal">Hello.</span><span class="name-reveal" aria-label={p.name}><span class="name-ink">{p.name}</span></span></h1>
            <p class="intro-role reveal">{p.headline} <span class="quiet-separator">/</span> {p.location}</p>
          </div>
          <a class="scroll-cue" href="#positioning" aria-label="Continue to the story"><span>SCROLL TO DISCOVER</span><span class="scroll-rule" aria-hidden="true"></span></a>
          <span class="scene-number">01 / THE INTRODUCTION</span>
        </section>

        <section class="scene scene-statement" id="positioning" aria-labelledby="position-title" data-scene>
          <div class="statement-wrap">
            <p class="eyebrow reveal">THE IDEA</p>
            <h2 id="position-title" class="display reveal-line">{p.positioning}</h2>
            <p class="scene-subline reveal">{p.pitch}</p>
          </div>
          <span class="scene-number">02 / WHAT I BELIEVE</span>
        </section>

        <section class="scene scene-problem" aria-labelledby="problem-title" data-scene>
          <div class="statement-wrap">
            <p class="eyebrow reveal">THE PROBLEM I SOLVE</p>
            <h2 id="problem-title" class="display reveal-line">{p.problem}</h2>
          </div>
          <div class="hairline-visual" aria-hidden="true"><i></i><span></span><i></i></div>
          <span class="scene-number">03 / WHY IT MATTERS</span>
        </section>

        <div class="work-intro scene" aria-labelledby="work-title" data-scene>
          <div class="statement-wrap">
            <p class="eyebrow reveal">THE PROOF</p>
            <h2 id="work-title" class="display reveal-line">The work.</h2>
            <p class="scene-subline reveal">Real problems. Thoughtful solutions.</p>
          </div>
          <span class="scene-number">04 / SELECTED WORK</span>
        </div>

        {p.projects.map((project, i) => (
          <section class="project-chapter" aria-labelledby={"project-title-" + i} data-project>
            <div class="project-sticky">
              <div class="project-copy">
                <p class="eyebrow project-label">PROJECT {index(i)} <span class="slash">/</span> {project.role}</p>
                <h2 id={"project-title-" + i} class="project-headline">{project.outcome}</h2>
                <p class="project-caption">{project.caption}</p>
                <div class="project-details">
                  <p class="project-title-small">{project.title}</p>
                  <p>{project.result}</p>
                  {project.links.length > 0 && <div class="project-links">{project.links.map(link => <a href={asset(link.url)} target="_blank" rel="noopener noreferrer">{link.label} <span aria-hidden="true">↗</span></a>)}</div>}
                </div>
              </div>
              <div class="project-stage">
                {project.media.some(m => m.kind === "image") ? (
                  <div class="project-image"><img src={asset(project.media.find(m => m.kind === "image")!.url)} alt={project.media.find(m => m.kind === "image")!.alt} loading="lazy" /></div>
                ) : project.media.some(m => m.kind === "video") ? (
                  <div class="project-image"><video src={asset(project.media.find(m => m.kind === "video")!.url)} controls playsinline preload="none" aria-label={project.media.find(m => m.kind === "video")!.alt}>Your browser does not support this video.</video></div>
                ) : (
                  <div class={"product-render product-" + project.visual.kind + " visual-" + p.heroVisual} aria-label={project.title + " concept visualization"}>
                    <div class="render-glow" aria-hidden="true"></div>
                    <div class="render-device">
                      <div class="render-topline"><span class="render-dots" aria-hidden="true"><i></i><i></i><i></i></span><span>{project.visual.kicker}</span><span class="render-corner">↗</span></div>
                      <div class="render-body">
                        <div class="render-heading">{project.visual.title}</div>
                        <div class="render-bars" aria-hidden="true"><b></b><b></b><b></b></div>
                        <div class="render-rows">{project.visual.rows.map((row, j) => <div class="render-row"><span class="render-index">{index(j)}</span><span>{row}</span><span aria-hidden="true">↗</span></div>)}</div>
                      </div>
                      <div class="render-bottom"><span>{project.visual.tag}</span><span>{index(i)} — {String(p.projects.length).padStart(2, "0")}</span></div>
                    </div>
                  </div>
                )}
                <span class="visual-caption">{project.media.length ? "PROJECT MEDIA" : "DESIGN REPRESENTATION"} · {project.title.toUpperCase()}</span>
              </div>
              <div class="project-progress" aria-hidden="true"><span></span></div>
            </div>
          </section>
        ))}

        <section class="scene scene-numbers" aria-labelledby="numbers-title" data-scene>
          <div class="numbers-inner">
            <p class="eyebrow reveal">BY THE NUMBERS</p>
            <h2 id="numbers-title" class="section-heading reveal-line">The details speak.</h2>
            <div class="metrics-grid">
              {p.numbers.map(n => (
                <article class="metric-card">
                  <div class="metric-value" data-count={n.value} data-suffix={n.suffix}>{n.value}{n.suffix}</div>
                  <h3>{n.label}</h3>
                  <p>{n.detail}</p>
                </article>
              ))}
            </div>
          </div>
          <span class="scene-number">05 / THE MEASURE</span>
        </section>

        <section class="scene scene-craft" aria-labelledby="craft-title" data-scene>
          <div class="craft-inner">
            <div class="craft-header">
              <div><p class="eyebrow reveal">THE CRAFT</p><h2 id="craft-title" class="section-heading reveal-line">Thought in every detail.</h2></div>
              <p class="craft-summary">{p.story}</p>
            </div>
            <div class="craft-grid">
              {p.skills.map((skill, i) => (
                <article class="craft-cell">
                  <span class="cell-number">0{ i + 1 }</span>
                  <h3>{skill.group}</h3>
                  <p>{skill.items.join(" / ")}</p>
                </article>
              ))}
              {p.credentials.map((cred, i) => (
                <article class="craft-cell credential-cell">
                  <span class="cell-number">C{ i + 1 }</span>
                  <h3>{cred.title}</h3>
                  <p>{cred.issuer} <span class="cred-status">· {cred.status}</span></p>
                </article>
              ))}
            </div>
          </div>
          <span class="scene-number">06 / CAPABILITIES</span>
        </section>

        {p.testimonials.map((testimonial, i) => (
          <section class="scene scene-testimonial" aria-labelledby={"testimonial-title-" + i} data-scene>
            <div class="testimonial-inner"><p class="eyebrow reveal">IN THEIR WORDS</p><h2 id={"testimonial-title-" + i} class="testimonial-quote reveal-line">“{testimonial.quote}”</h2><p class="testimonial-credit reveal">{testimonial.author} <span>/ {testimonial.role}</span></p></div>
            <span class="scene-number">07 / THE PEOPLE</span>
          </section>
        ))}

        <section class="scene scene-surprise" aria-labelledby="surprise-title" data-scene>
          <div class="surprise-inner">
            <p class="eyebrow reveal">{p.surprise.signoff}</p>
            <h2 id="surprise-title" class="display surprise-headline reveal-line">{p.surprise.headline}</h2>
            <p class="surprise-detail reveal">{p.surprise.detail}</p>
          </div>
          <span class="scene-number">07 / ONE MORE THING</span>
        </section>

        <section class="scene scene-contact" id="contact" aria-labelledby="contact-title" data-scene>
          <div class="contact-inner">
            <p class="eyebrow reveal">THE INVITATION</p>
            <h2 id="contact-title" class="display reveal-line">Let's make something matter.</h2>
            <p class="contact-subline reveal">{p.sample ? "A sample portfolio. Switch to your own config to make it yours." : "Have a problem worth solving? I'd love to hear it."}</p>
            {isContactable ? (
              <a class="primary-action" href="#contact-form"><span>Get in touch</span><span class="action-arrow" aria-hidden="true">↗</span></a>
            ) : (
              <p class="empty-contact">Contact details can be added in portfolio.config.ts.</p>
            )}
          </div>
          <span class="scene-number">08 / LET'S BEGIN</span>
        </section>

        {isContactable && (
          <section class="contact-form-section" id="contact-form" aria-labelledby="message-title">
            <div class="form-shell">
              <div><p class="eyebrow">A CONVERSATION STARTS HERE</p><h2 id="message-title">Tell me what you're building.</h2><p class="form-intro">Just a few words are enough to get started.</p></div>
              <form class="contact-form" method="post" action={p.contact.endpoint || "mailto:" + p.contact.email} data-contact data-address={p.contact.email}>
                <label>Your email <input type="email" name="email" required autocomplete="email" placeholder="you@example.com" maxlength="254" /></label>
                <label>Your message <textarea name="message" required rows="5" placeholder="I have an idea…" maxlength="5000"></textarea></label>
                <button class="form-submit" type="submit">Send message <span aria-hidden="true">↗</span></button>
                <p class="form-feedback" role="status" aria-live="polite"></p>
              </form>
            </div>
          </section>
        )}
      </div>

      <section class="recruiter-view" id="summary" tabindex="-1" aria-labelledby="summary-title">
        <div class="summary-container">
          <div class="summary-top"><span class="eyebrow">THE 30-SECOND VERSION</span><a class="back-story" href="#top">Experience the story <span aria-hidden="true">↗</span></a></div>
          <h1 id="summary-title">{p.name}</h1>
          <p class="summary-headline">{p.headline} <span aria-hidden="true">·</span> {p.location}</p>
          <p class="summary-pitch">{p.summary}</p>
          <div class="summary-cta"><a class="summary-download" href={resume} download>Download résumé <span aria-hidden="true">↓</span></a>{isContactable && <a href="#summary-contact">Contact <span aria-hidden="true">↗</span></a>}</div>
          <div class="summary-section"><h2>Selected projects</h2><div class="summary-projects">{p.projects.slice(0, 3).map((project, i) => <article><span class="summary-index">{index(i)}</span><div><h3>{project.title}</h3><p class="summary-project-outcome">{project.outcome}</p><p>{project.summary} {project.result}</p></div></article>)}</div></div>
          <div class="summary-columns"><div class="summary-section"><h2>Experience</h2>{p.experience.map(exp => <article class="summary-record"><span>{exp.date}</span><h3>{exp.title}</h3><p>{exp.detail}</p></article>)}</div><div class="summary-section"><h2>Skills & credentials</h2>{p.skills.map(skill => <article class="summary-record"><h3>{skill.group}</h3><p>{skill.items.join(" · ")}</p></article>)}{p.credentials.map(cred => <article class="summary-record"><h3>{cred.title}</h3><p>{cred.issuer} · {cred.status}</p></article>)}</div></div>
          <div class="summary-section summary-contact" id="summary-contact"><h2>Let's connect.</h2>{isContactable && <a class="summary-download" href={p.contact.email ? "mailto:" + p.contact.email : "#contact-form"}>{p.contact.email ? "Email me" : "Send a message"} <span aria-hidden="true">↗</span></a>}{p.contact.links.map(link => <a class="external-link" href={link.url} target="_blank" rel="noopener noreferrer">{link.label} ↗</a>)}{!isContactable && !p.contact.links.length && <p>Contact details can be added in the configuration.</p>}</div>
          <p class="summary-footer">{p.sample ? "Illustrative sample" : "Made with care"} <span>© {new Date().getFullYear()} {p.name}</span></p>
        </div>
      </section>
    </main>
    <script>import "../scripts/keynote.ts";</script>
  </body>
</html>
