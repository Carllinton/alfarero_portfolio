---
import { readFileSync } from "node:fs";
import Content from "./Content.astro";
import Icon from "./Icon.astro";
import type { Profile } from "../../portfolio.config";
import "../styles/desk.css";
const { p, slug = "" } = Astro.props as { p: Profile; slug?: string };
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const art = (s: string) => base + "/art/" + s + ".svg";
function dimensions(id: string) {
  const svg = readFileSync("public/art/" + id + ".svg", "utf8");
  const match = svg.match(/viewBox="0 0 ([\d.]+) ([\d.]+)"/);
  return match ? { width: Number(match[1]), height: Number(match[2]) } : {};
}
const resume = base + "/" + (slug ? slug + "/" : "") + "resume.pdf";
const og = new URL(base + "/art/preview-" + p.theme.mark + ".png", Astro.site);
const canonical = new URL(Astro.url.pathname, Astro.site);
const groups = [
  "about",
  "projects",
  "experience",
  "skills",
  "credentials",
  "personal",
  "contact",
] as const;
---

<!doctype html>
<html
  lang="en"
  style={`--accent:${p.accent};--wood:${p.theme.surface};--grain:url("${base}/art/wood.webp")`}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>The Desk — {p.name}</title>
    <meta name="description" content={p.summary} />
    <meta property="og:title" content={"The Desk — " + p.name} />
    <meta property="og:description" content={p.pitch} />
    <meta property="og:image" content={og} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={base + "/art/favicon.svg"} />
  </head>
  <body>
    <a href="#quick" class="skip">
      Skip to Quick View
    </a>
    <header>
      <div class="brand">
        <Icon name="lamp" />
        <span>The Desk</span>
      </div>
      <span class="headerline"></span>
      <span class="brand-sub">Personal portfolio</span>
      <nav aria-label="Desk controls">
        <button id="light" aria-pressed="false">
          <Icon name="sun" />
          <span>Day</span>
        </button>
        <button id="motion" type="button" aria-pressed="false" hidden>
          <span>Motion off</span>
        </button>
        <button id="audio" aria-pressed="false">
          <Icon name="volume" />
          <span>Sound off</span>
        </button>
        <a class="quick-button" href="#quick">
          <Icon name="list" />
          <span>Quick View</span>
        </a>
      </nav>
    </header>
    <main id="workspace">
      <div class="stage" id="stage">
        <div class="window-light" aria-hidden="true"></div>
        <div class="motes" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
        <div class="spot"></div>
        <div class="layout">
          <div class="intro">
            <div class="kicker">
              <i></i>
              {p.sample ? "Sample portfolio" : "Interactive portfolio"}
            </div>
            <h1>
              The Desk<span>.</span>
            </h1>
            <p class="byline">of {p.name}</p>
            <p class="pitch" data-pitch={p.pitch}>
              {p.pitch}
            </p>
            <div class="role">{p.headline}</div>
          </div>
          <div class="annotation" aria-hidden="true">
            pick an object
            <svg viewBox="0 0 51 28">
              <path d="M2 4q10 25 44 7m-9-1 10 0-4 8" />
            </svg>
          </div>
          {p.objects.map((o, i) => (
            <a
              class={"object obj-" + o.type}
              href={"#" + o.id}
              data-object={o.id}
              style={`--order:${i};--x:${o.position.x}%;--y:${o.position.y}%;--w:${o.position.width}%;--r:${o.position.angle}deg`}
            >
              <img
                class="art"
                {...dimensions(o.illustration)}
                loading={i < 2 ? "eager" : "lazy"}
                src={art(o.illustration)}
                alt={o.alt}
                draggable="false"
              />
              {["coffee", "tea"].includes(o.illustration) && (
                <svg class="steam" viewBox="0 0 48 48" aria-hidden="true">
                  <path d="M14 40c9-11-9-14-1-28" />
                  <path d="M26 39c-8-10 10-17 3-29" />
                </svg>
              )}
              <span class="tag">
                <b>{String(i + 1).padStart(2, "0")}</b>
                {o.label}
                <svg
                  aria-hidden="true"
                  viewBox="0 0 12 12"
                  width="10"
                  height="10"
                  fill="none"
                  stroke="currentColor"
                >
                  <path d="M2 10l8-8m-6 0h6v6" />
                </svg>
              </span>
            </a>
          ))}
          <a class="secret" href="#note" aria-label={"Inspect " + p.secret.alt}>
            <img src={art(p.secret.illustration)} alt="" />
          </a>
          {p.theme.props.map((prop) => (
            <img
              class="prop"
              src={art(prop.art)}
              {...dimensions(prop.art)}
              alt=""
              aria-hidden="true"
              style={`left:${prop.x}%;top:${prop.y}%;width:${prop.width}%;transform:rotate(${prop.angle}deg)`}
            />
          ))}
        </div>
      </div>
      <section
        id="quick"
        class="quick paper"
        aria-labelledby="quicktitle"
        tabindex="-1"
      >
        <div class="folio">QUICK VIEW</div>
        <h1 id="quicktitle">{p.name}</h1>
        <p class="byline">{p.headline}</p>
        <a class="action" href={resume} download>
          Download résumé PDF ↓
        </a>
        {groups.map((type) => (
          <section>
            <h2 class="sectiontitle">
              {p.objects.find((o) => o.type === type)?.label || type}
            </h2>
            <Content p={p} type={type} uid="quick" />
          </section>
        ))}
      </section>
    </main>
    <footer>
      <span>
        <i class="online"></i>
        {p.location}
      </span>
      <button id="ambient" type="button" aria-pressed="true" aria-label="Ambient motion">Ambient motion on</button>
      <span class="footcenter">
        <Icon name="cursor" /> Select an object to explore
      </span>
      <span>
        THE DESK <i>/</i> {new Date().getUTCFullYear()}
      </span>
    </footer>
    <dialog aria-labelledby="sheet-title">
      <article class="paper sheet">
        <div class="sheetbar">
          <button class="back">← Back to desk</button>
          <button class="close" aria-label="Close section">
            ×
          </button>
        </div>
        <div id="sheet-content"></div>
      </article>
    </dialog>
    {p.objects.map((o, i) => (
      <template id={"tpl-" + o.id}>
        <div class="folio">
          DESK OBJECT &nbsp; / &nbsp; {String(i + 1).padStart(2, "0")}
        </div>
        <h2 id="sheet-title">{o.label}</h2>
        <Content p={p} type={o.type} />
        {o.type === "credentials" && (
          <a class="action" href={resume} download>
            Download résumé PDF ↓
          </a>
        )}
      </template>
    ))}
    <template id="tpl-note">
      <div class="folio">A LITTLE FIND</div>
      <h2 id="sheet-title">A personal note</h2>
      <p class="lede">{p.secret.note}</p>
      <p class="byline">— {p.firstName}</p>
    </template>
    <noscript>
      <style>
        .stage,
        nav button,
        .quick-button,
        .footcenter {
          display: none !important;
        }
        .quick {
          display: block !important;
        }
      </style>
    </noscript>
    <script src="../scripts/desk.ts"></script>
  </body>
</html>
